{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["ES2018", "DOM"],
    "module": "commonjs",
    "jsx": "react-jsx",
    "moduleSuffixes": [".native", ""],
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "noEmit": true
  },
  "include": ["src", "types/react-native-stubs.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.web.ts", "**/*.web.tsx"]
}
